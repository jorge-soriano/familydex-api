PORT=3001
NODE_ENV=development

# OWASP A05: Solo permite peticiones desde este origen
# En producción: https://tu-dominio.com
CORS_ORIGIN=http://localhost:5174

PORT=3001
NODE_ENV=development

# PostgreSQL — desarrollo local (Docker: docker-compose up -d)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=familydex_dev
DB_USER=familydex
DB_PASSWORD=familydex
DB_SSL=false

# Base de datos de tests (creada automáticamente por Docker)
DB_NAME_TEST=familydex_test

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Producción (Supabase): ajusta DB_HOST, DB_NAME, DB_USER, DB_PASSWORD y pon DB_SSL=true
